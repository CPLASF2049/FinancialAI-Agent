# ============================================================================
# Fin-Agent MCP + LangGraph —— 配置
# 复制为 `.env` 后按需修改。所有配置项都有默认值：不填任何东西也能把整套
# 系统跑起来（离线行情数据 + 确定性规划器）。
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 行情数据源
# ---------------------------------------------------------------------------
# `offline` -> 确定性的离线 fixture。不需要 token、不需要联网。测试、演示和 CI
#              都用它；所有工具返回的数据形态都是合理的。
# `tushare` -> 真实的 Tushare Pro 接口，需要 TUSHARE_TOKEN。
FINAGENT_PROVIDER=offline

# Tushare Pro 的 token（https://tushare.pro）。也可用 TUSHARE_TOKEN。
FINAGENT_TUSHARE_TOKEN=

# 客户端侧的限速（每秒请求数）。
FINAGENT_TUSHARE_RPS=4

# ---------------------------------------------------------------------------
# 2. LLM（OpenAI 兼容协议）
# ---------------------------------------------------------------------------
# 想接入 DeepSeek，把下面两行填上即可（模型与 base URL 都有默认值，不用改）：
#     FINAGENT_LLM_PROVIDER=deepseek
#     FINAGENT_LLM_API_KEY=sk-你的deepseek密钥
# 改完执行 `finagent doctor`，最后一行应显示「LLM 已启用」。
#
# `none` -> 确定性规划器：Supervisor 用关键词规则路由，专家跑手写流程，
#           但调的是同一套 MCP 工具。零 API Key 也能跑。
#
# 可选值：deepseek | openai | kimi | glm | qwen | spark | maas | siliconflow | local | custom
#
#   spark  = 讯飞星火（Key 用控制台的 APIPassword）
#   maas   = 讯飞星辰 MaaS（Key 是 ak- 开头，模型名看「模型服务列表」）
#   custom = 任意 OpenAI 兼容接口，地址和模型名都要自己填
#
# 也可以不改文件：启动 `finagent` 后点界面右上角「接入大模型」，填完立刻生效。
FINAGENT_LLM_PROVIDER=none

# DeepSeek 的 key（也认 DEEPSEEK_API_KEY / OPENAI_API_KEY 这两个别名）。
# 注意：只填 key 不够，必须同时把上面的 FINAGENT_LLM_PROVIDER 改成 deepseek。
FINAGENT_LLM_API_KEY=
FINAGENT_LLM_MODEL=deepseek-chat
FINAGENT_LLM_BASE_URL=https://api.deepseek.com
FINAGENT_LLM_TEMPERATURE=0.2
FINAGENT_LLM_TIMEOUT=90

# ---------------------------------------------------------------------------
# 3. 图的行为
# ---------------------------------------------------------------------------
# 单轮对话里 Supervisor 最多跳转几次专家。
FINAGENT_MAX_AGENT_HOPS=4
# 单个专家一轮里最多迭代几次工具调用。
FINAGENT_MAX_TOOL_ITERATIONS=8

# `inprocess` 把 MCP 服务器挂在当前进程内（快，不起子进程）。
# `stdio`    真的把它们拉起为 MCP 服务器子进程（生产形态）。
FINAGENT_MCP_TRANSPORT=inprocess

# ---------------------------------------------------------------------------
# 4. 存储
# ---------------------------------------------------------------------------
# 会话 checkpoint、持仓、预警、画像和记忆都放在这里。默认 ~/.finagent
FINAGENT_DATA_DIR=
FINAGENT_CHECKPOINT_DB=checkpoints.sqlite

# ---------------------------------------------------------------------------
# 5. 预警 worker
# ---------------------------------------------------------------------------
FINAGENT_ALERT_POLL_SECONDS=60
FINAGENT_ALERT_TRADING_HOURS_ONLY=true

# 可选：预警触发后的邮件投递。不配置时，预警会写入
# <数据目录>/alerts_log.jsonl 并打印到控制台。
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=465
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=

# ---------------------------------------------------------------------------
# 6. 可观测性
# ---------------------------------------------------------------------------
FINAGENT_LOG_LEVEL=INFO
